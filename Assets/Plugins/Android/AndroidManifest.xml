<?xml version="1.0" encoding="utf-8"?>
<!--
  GDD 3/4: AdMob entegrasyonu + cross-platform (Android) gereksinimleri.
  Bu dosya Unity'nin ürettiği taban manifest ile Gradle tarafından birleştirilir (merge).

  APPLICATION_ID değeri projenin gerçek AdMob hesabındaki App ID'dir
  (ca-app-pub-3337422341749058~7427319010), 2026-08-04'te test ID'nin yerine kondu.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3337422341749058~7427319010" />
    </application>
</manifest>
