<?xml version="1.0" encoding="utf-8"?>
<!--
  GDD 3/4: AdMob entegrasyonu + cross-platform (Android) gereksinimleri.
  Bu dosya Unity'nin ürettiği taban manifest ile Gradle tarafından birleştirilir (merge).

  ÖNEMLİ: APPLICATION_ID değeri şu an Google'ın herkese açık TEST App ID'sidir
  (https://developers.google.com/admob/unity/quick-start#update_your_androidmanifestxml).
  V1.0 mağaza gönderiminden önce AdMob konsolundaki gerçek App ID ile değiştirilmeli.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
    </application>
</manifest>
